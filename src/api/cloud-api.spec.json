          "firstName": { "type": "string", "example": "John" },
          "lastName": { "type": "string", "example": "Doe" },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "/^[a-zA-Z0-9_]+$/",
            "example": "john_doe"
          },
          "email": {
            "type": "string",
