              "QUEUED",
              "PRINTING",
              "COMPLETED",
              "REJECTED",
              "ERROR"
            ]
          },
          "documentId": { "type": "number" },
          "outputColor": {
            "type": "string",
            "enum": ["Color", "Monochrome", "Grayscale"]
