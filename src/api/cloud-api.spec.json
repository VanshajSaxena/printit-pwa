          "yesterdaySheets": { "type": "number" },
          "sheetPercentageChange": { "type": "number", "nullable": true },
          "todayOrders": { "type": "number" },
          "yesterdayOrders": { "type": "number" },
          "orderPercentageChange": { "type": "number", "nullable": true },
          "totalUsers": { "type": "number" },
          "todayUsers": { "type": "number" },
          "yesterdayUsers": { "type": "number" },
          "userPercentageChange": { "type": "number", "nullable": true },
          "todayNewUsers": { "type": "number" },
