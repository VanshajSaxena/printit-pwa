            "type": "string"
          },
          "friendlyId": { "type": "string" },
          "jobs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CreateJobResponseDto" }
          },
          "createdAt": { "format": "date-time", "type": "string" },
          "updatedAt": { "format": "date-time", "type": "string" },
          "vendorId": { "type": "number" }
        },
        "required": [
          "id",
          "status",
          "friendlyId",
          "jobs",
          "createdAt",
          "updatedAt",
          "vendorId"
        ]
