          "reason": { "type": "string" }
        },
        "required": ["status"]
      },
      "CreateDocumentRequestDto": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "contentType": { "type": "string" },
          "draftId": { "type": "string" },
          "pageCount": { "type": "number" }
