              "PRINTING",
              "COMPLETED",
              "REJECTED",
              "ERROR"
            ]
          }
        },
        "required": ["status"]
      },
      "UpdateTransactionDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
