          "signedUrls": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DownloadFileResponseDto" }
          }
        },
        "required": ["signedUrls"]
      },
      "DashboardCardAnalytics": {
        "type": "object",
        "properties": {
