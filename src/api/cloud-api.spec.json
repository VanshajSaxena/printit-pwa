            }
          },
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponseDto" }
              }
            }
          },
          "401": { "description": "Code invalid or expired" }
        },
        "summary": "Exchange one-time OAuth code for token pair",
        "tags": ["Auth"]
      }
    },
