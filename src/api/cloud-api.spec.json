        "required": ["status"]
      },
      "UpdateJobStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "QUEUED",
              "PRINTING",
              "COMPLETED",
              "REJECTED",
              "ERROR"
            ]
          }
        },
        "required": ["status"]
      },
