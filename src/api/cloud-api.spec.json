  "info": {
    "title": "Printit",
    "description": "Printit Cloud API.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateVendorDto": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "/^[a-zA-Z0-9_]+$/"
          },
          "email": { "type": "string", "format": "email" },
          "displayName": { "type": "string" },
          "address": { "type": "string" },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
        },
        "required": ["firstName", "lastName", "username", "email"]
      },
      "LocationDto": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "nullable": true,
            "example": 12.9716
          },
          "longitude": {
            "type": "number",
            "nullable": true,
            "example": 77.5946
          }
        },
        "required": ["latitude", "longitude"]
      },
      "VendorResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "displayName": { "type": "string", "nullable": true },
          "username": { "type": "string" },
          "address": { "type": "string" },
          "slug": { "type": "string" },
          "location": {
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/LocationDto" }]
          },
          "distance": { "type": "number" }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "displayName",
          "username",
          "address",
          "slug",
          "location",
          "distance"
        ]
      },
      "NotFoundErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": { "type": "number", "example": 404 },
          "message": { "type": "string", "example": "Entity not found" },
          "error": { "type": "string", "example": "Not Found" }
        },
        "required": ["statusCode", "message", "error"]
      },
      "VendorPresenceDto": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["online", "offline", "away"] },
          "id": { "type": "number" }
        },
        "required": ["status", "id"]
      },
      "UpdateVendorDto": { "type": "object", "properties": {} },
      "CreatePrinterDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "capabilities": { "type": "string", "format": "json" },
          "vendorId": { "type": "number" }
        },
        "required": ["name", "capabilities", "vendorId"]
      },
      "PrinterResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "capabilities": { "type": "string", "format": "json" }
        },
        "required": ["id", "name", "capabilities"]
      },
      "UpdatePrinterDto": { "type": "object", "properties": {} },
      "CreateJobRequestDto": {
        "type": "object",
        "properties": {
          "documentId": { "type": "number" },
          "outputColor": {
            "enum": ["Color", "Monochrome", "Grayscale"],
            "type": "string"
          },
          "copyCount": { "type": "number", "minimum": 1 }
        },
        "required": ["documentId", "outputColor", "copyCount"]
      },
      "CreateTransactionRequestDto": {
        "type": "object",
        "properties": {
          "vendorId": { "type": "number" },
          "jobs": {
            "minItems": 1,
            "type": "array",
            "items": { "$ref": "#/components/schemas/CreateJobRequestDto" }
          }
        },
        "required": ["vendorId", "jobs"]
      },
      "CreateDocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "filename": { "type": "string" },
          "contentType": { "type": "string" },
          "draftId": { "type": "string" },
          "createdAt": { "format": "date-time", "type": "string" },
          "updatedAt": { "format": "date-time", "type": "string" }
