{
  "name": "printit-mobile",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "scripts": {
    "start:dev": "ionic serve --no-open --external",
    "api:gen": "openapi-typescript ./src/api/cloud-api.spec.json --alphabetize --root-types --root-types-no-schema-prefix --output ./src/api/cloud-api-types.ts",
    "api:mod": "openapi-typescript http://localhost:3000/docs/json --alphabetize --root-types --root-types-no-schema-prefix --output ./src/api/cloud-api-types.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.0.1",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "idb-keyval": "^6.2.2",
    "immer": "^11.1.3",
    "ionicons": "^7.4.0",
    "openapi-fetch": "^0.15.0",
    "openapi-react-query": "^0.5.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.0.1",
    "@ionic/cli": "^7.2.1",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^4.0.1",
    "cypress": "^13.5.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-dom": "^2.7.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-react-x": "^2.7.2",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^0.34.6"
  },
  "resolutions": {
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4"
  },
  "description": "An Ionic project",
  "packageManager": "yarn@4.12.0"
}
